{
  "name": "@mongrov/vitals-hooks",
  "version": "0.1.1",
  "description": "View-model layer for the ZivaOne vital screens — the contract surface screens render, over @mongrov/data-access.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "require": "./dist/mock/index.js",
      "default": "./dist/mock/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": { "access": "public" }
}
