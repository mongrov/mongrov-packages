{
  "name": "@mongrov/analytics",
  "version": "0.10.0",
  "sideEffects": false,
  "description": "DuckDB + R2 Iceberg local analytics for @mongrov apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongrov/mongrov-packages.git",
    "directory": "packages/analytics"
  },
  "keywords": [
    "react-native",
    "expo",
    "duckdb",
    "iceberg",
    "analytics",
    "r2",
    "cloudflare"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js",
      "default": "./dist/rules/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./tools/mcp": {
      "types": "./dist/tools/mcp/index.d.ts",
      "import": "./dist/tools/mcp/index.js",
      "default": "./dist/tools/mcp/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "UPGRADING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0",
    "@mongrov/db": "workspace:^",
    "@mongrov/types": "^0.5.1",
    "ai": ">=4",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-duckdb": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-duckdb": {
      "optional": true
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "date-fns-tz": "^3.2.0",
    "nanoid": "^5.0.9",
    "p-queue": "^8.0.1",
    "xstate": "^5.30.0",
    "zod": "^3.23.8 || ^4.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@duckdb/node-bindings": "1.5.4-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mongrov/db": "workspace:*",
    "@mongrov/types": "workspace:*",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ai": "^4.3.0",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^3.23.8"
  }
}
