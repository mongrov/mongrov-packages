{
  "name": "@mongrov/types",
  "version": "0.5.0",
  "description": "Shared type definitions for @mongrov packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongrov/mongrov-packages.git",
    "directory": "packages/types"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/cjs/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./analytics-queries": {
      "types": "./dist/esm/analytics-queries.d.ts",
      "import": "./dist/esm/analytics-queries.js",
      "require": "./dist/cjs/analytics-queries.js",
      "default": "./dist/esm/analytics-queries.js"
    },
    "./device-events": {
      "types": "./dist/esm/device-events.d.ts",
      "import": "./dist/esm/device-events.js",
      "require": "./dist/cjs/device-events.js",
      "default": "./dist/esm/device-events.js"
    },
    "./package.json": "./package.json",
    "./kv-keys": {
      "types": "./dist/esm/kv-keys.d.ts",
      "import": "./dist/esm/kv-keys.js",
      "require": "./dist/cjs/kv-keys.js",
      "default": "./dist/esm/kv-keys.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-manifests.mjs",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "zod": "^3.23.8 || ^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "module": "dist/esm/index.js"
}
